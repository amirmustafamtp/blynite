# Blynite contact form — copy to .env.local for local development.
# In Vercel, add these variables to Production and redeploy.
CONTACT_PROVIDER=resend
CONTACT_TO_EMAIL=info@blynite.com
# Verify blynite.com in Resend before using this sender.
CONTACT_FROM_EMAIL="Blynite Website <website@blynite.com>"
# Create a Resend API key with sending access. Leave blank until ready.
RESEND_API_KEY=
# Generate a private secret with: openssl rand -hex 32
# Do not commit real secrets or API keys to this example file.
CONTACT_FORM_SECRET=
# Public email fallback displayed on the contact page.
NEXT_PUBLIC_CONTACT_EMAIL=info@blynite.com

# Optional alternative provider: set CONTACT_PROVIDER=webhook to use these.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=
RATE_LIMIT_TRUST_PROXY=false
